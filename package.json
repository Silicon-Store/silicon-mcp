{
  "name": "silicon-mcp",
  "version": "1.0.0",
  "description": "MCP server for shopping — search products, compare prices, and look up product details from any AI agent. Works with Claude, Cursor, and Codex.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Silicon-Store/silicon-mcp",
  "repository": { "type": "git", "url": "git+https://github.com/Silicon-Store/silicon-mcp.git" },
  "bugs": { "url": "https://github.com/Silicon-Store/silicon-mcp/issues" },
  "bin": {
    "silicon-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai-agents",
    "agentic",
    "agentic-commerce",
    "shopping",
    "price-comparison",
    "online-shopping",
    "ecommerce",
    "silicon"
  ]
}
